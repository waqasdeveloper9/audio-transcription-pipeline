<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core Speech-to-Text Engine (Whisper.net open-source runtime bindings) -->
    <PackageReference Include="Whisper.net" Version="1.7.4" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.7.4" />
    <!-- Audio format converter & resampler (MP3/M4A -> 16kHz mono WAV) -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
